# ServiceDesk Copilot - environment variable names and documented defaults.
# Copy to .env and fill locally. .env is gitignored and never committed.
# Nothing in this file is a real credential or a real value.

# Run mode: ci_fake | demo_fake | hosted
SDC_MODE=ci_fake

# Listen host. Local mode binds loopback only; any other value is refused at
# startup and there is no widening flag.
SDC_LISTEN_HOST=127.0.0.1

# Listen port.
SDC_LISTEN_PORT=8000

# Write path switch (ticket creation). Reads are not affected.
SDC_WRITES_ENABLED=true

# Hosted provider calls stay disabled unless this is explicitly enabled in
# addition to a per-run approval. No hosted call happens in B0.
SDC_ALLOW_HOSTED_CALLS=false

# Runtime directory for the instance lock, backups and run records.
SDC_RUNTIME_DIR=./runtime

# Hosted provider key (B5 and later, provider undecided). Name only; the value
# is supplied locally in .env and is never printed or logged.
# SDC_HOSTED_API_KEY=
